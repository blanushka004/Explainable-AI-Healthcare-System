# Optional. With no DATABASE_URL, the app creates healthcare.db in the project root.
# PostgreSQL: first install requirements-postgres.txt, create healthcare_db,
# and set your own credentials. URL-encode special characters in passwords.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/healthcare_db
# Set COOKIE_SECURE=true when serving over HTTPS. Leave unset for local HTTP.
# COOKIE_SECURE=false
# SESSION_DAYS=8
